{
  "name": "screenshot-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify:overlay": "npm run build && node verify-overlay.mjs",
    "verify:capture": "powershell -NoProfile -ExecutionPolicy Bypass -File verify-capture.ps1",
    "verify:coldstart": "powershell -NoProfile -ExecutionPolicy Bypass -File verify-coldstart.ps1",
    "verify:video": "powershell -NoProfile -ExecutionPolicy Bypass -File verify-video.ps1",
    "verify:idle": "powershell -NoProfile -ExecutionPolicy Bypass -File verify-idle.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
